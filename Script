    Row.Text = ""
    Row.Parent = parent
    local RowCorner = Instance.new("UICorner"); RowCorner.CornerRadius = UDim.new(0, 4); RowCorner.Parent = Row
    local Txt = Instance.new("TextLabel")
    Txt.Size = UDim2.new(1, -30, 1, 0)
    Txt.Position = UDim2.new(0, 10, 0, 0)
    Txt.BackgroundTransparency = 1
    Txt.Text = GetTranslated(textKey)
    Txt.TextColor3 = defaultState and Color3.fromRGB(255, 255, 255) or Color3.fromRGB(200, 200, 200)
    Txt.Font = Enum.Font.GothamMedium
    Txt.TextSize = 12
    Txt.TextXAlignment = Enum.TextXAlignment.Left
    Txt.Parent = Row
    RegisterText(Txt, textKey)
    local Cb = Instance.new("Frame")
    Cb.Size = UDim2.new(0, 14, 0, 14)
    Cb.Position = UDim2.new(1, -22, 0.5, -7)
    Cb.BackgroundColor3 = Color3.fromRGB(20, 20, 20)
    Cb.Parent = Row
    local CbStroke = Instance.new("UIStroke"); CbStroke.Color = Color3.fromRGB(100, 100, 100); CbStroke.Thickness = 1.5; CbStroke.Parent = Cb
    local CbFill = Instance.new("Frame")
    CbFill.Size = UDim2.new(0, 6, 0, 6)
    CbFill.Position = UDim2.new(0.5, -3, 0.5, -3)
    CbFill.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
    CbFill.Visible = defaultState
    CbFill.Parent = Cb
    
    local function SetState(state)
        CbFill.Visible = state
        Txt.TextColor3 = state and Color3.fromRGB(255, 255, 255) or Color3.fromRGB(200, 200, 200)
    end
    
    Row.MouseButton1Click:Connect(function()
        local newState = not CbFill.Visible
        SetState(newState)
        callback(newState)
    end)
    
    return Row, SetState
end

local function CreateSlider(parent, textKey, yPos, minVal, maxVal, defaultVal, callback)
    local Frame = Instance.new("Frame")
    Frame.Size = UDim2.new(1, 0, 0, 40)
    Frame.Position = UDim2.new(0, 0, 0, yPos)
    Frame.BackgroundColor3 = Color3.fromRGB(25, 25, 25)
    Frame.Parent = parent
    local FCorner = Instance.new("UICorner"); FCorner.CornerRadius = UDim.new(0, 4); FCorner.Parent = Frame
    local Label = Instance.new("TextLabel")
    Label.Size = UDim2.new(1, 0, 0, 18)
    Label.Position = UDim2.new(0, 10, 0, 2)
    Label.BackgroundTransparency = 1
    Label.Text = GetTranslated(textKey) .. ": " .. defaultVal
    Label.TextColor3 = Color3.fromRGB(200, 200, 200)
    Label.Font = Enum.Font.GothamMedium
    Label.TextSize = 12
    Label.TextXAlignment = Enum.TextXAlignment.Left
    Label.Parent = Frame
    local Bg = Instance.new("Frame")
    Bg.Size = UDim2.new(1, -20, 0, 6)
    Bg.Position = UDim2.new(0, 10, 0, 22)
    Bg.BackgroundColor3 = Color3.fromRGB(50, 50, 50)
    Bg.Parent = Frame
    local Fill = Instance.new("Frame")
    Fill.Size = UDim2.new((defaultVal - minVal) / (maxVal - minVal), 0, 1, 0)
    Fill.BackgroundColor3 = Color3.fromRGB(200, 200, 200)
    Fill.Parent = Bg
    local Knob = Instance.new("Frame")
    Knob.Size = UDim2.new(0, 12, 0, 12)
    Knob.Position = UDim2.new((defaultVal - minVal) / (maxVal - minVal), -6, 0.5, -6)
    Knob.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
    Knob.Parent = Bg
    local KCorner = Instance.new("UICorner"); KCorner.CornerRadius = UDim.new(1, 0); KCorner.Parent = Knob
    
    table.insert(UI_Sliders, {label = Label, key = textKey, value = defaultVal})
    
    local dragging = false
    Bg.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then dragging = true end
    end)
    UserInputService.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then dragging = false end
    end)
    UserInputService.InputChanged:Connect(function(input)
        if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
            local relX = math.clamp((UserInputService:GetMouseLocation().X - Bg.AbsolutePosition.X) / Bg.AbsoluteSize.X, 0, 1)
            Fill.Size = UDim2.new(relX, 0, 1, 0)
            Knob.Position = UDim2.new(relX, -6, 0.5, -6)
            local val = math.floor((minVal + (relX * (maxVal - minVal))) * 100) / 100
            Label.Text = GetTranslated(textKey) .. ": " .. val
            
            for _, slider in ipairs(UI_Sliders) do
                if slider.label == Label then slider.value = val break end
            end
            
            callback(val)
        end
    end)
    return Frame
end

