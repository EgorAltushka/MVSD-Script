function ClearHitboxes()
    for part, oldSize in pairs(originalHitboxSizes) do
        if part and part.Parent then
            part.Size = oldSize
        end
    end
    originalHitboxSizes = {}
    ClearHitboxVisuals()
end

function ClearHitboxVisuals()
    for part, box in pairs(activeHitboxVisuals) do
        if box then box:Destroy() end
    end
    activeHitboxVisuals = {}
end

function UpdateHitboxVisual(part, size)
    if _G.PidorasSettings.HitboxVisualEnabled then
        if not activeHitboxVisuals[part] then
            local box = Instance.new("BoxHandleAdornment")
            box.Size = Vector3.new(size, size, size)
            box.Adornee = part
            box.AlwaysOnTop = true
            box.ZIndex = 5
            box.Transparency = 0.5
            box.Color3 = Color3.fromRGB(255, 0, 0)
            box.Parent = part
            activeHitboxVisuals[part] = box
        else
            activeHitboxVisuals[part].Size = Vector3.new(size, size, size)
        end
    else
        if activeHitboxVisuals[part] then
            activeHitboxVisuals[part]:Destroy()
            activeHitboxVisuals[part] = nil
        end
    end
end

function StartHitbox()
    task.spawn(function()
        while _G.PidorasSettings.HitboxEnabled do
            local size = _G.PidorasSettings.HitboxSize
            for _, plr in ipairs(Players:GetPlayers()) do
                if plr ~= LocalPlayer and plr.Character then
                    local hrp = plr.Character:FindFirstChild("HumanoidRootPart")
                    local head = plr.Character:FindFirstChild("Head")
                    
                    if hrp then
                        if not originalHitboxSizes[hrp] then originalHitboxSizes[hrp] = hrp.Size end
                        hrp.Size = Vector3.new(size, size, size)
                        hrp.Transparency = 1
                        hrp.CanCollide = false
                        UpdateHitboxVisual(hrp, size)
                    end
                    
                    if head then
                        if not originalHitboxSizes[head] then originalHitboxSizes[head] = head.Size end
                        head.Size = Vector3.new(size, size, size)
                        head.Transparency = 1
                        head.CanCollide = false
                        UpdateHitboxVisual(head, size)
                    end
                end
            end
            task.wait(0.2)
        end
    end)
end

